# Môi trường / build
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Secrets — KHÔNG commit (.env.example / .env.docker.example là template được theo repo)
.env
.env.docker
.env.agent
.env.local
.env.*.local
deploy/*.env
deploy/backups/

# Artifacts lớn — tái lập bằng `python scripts/build_all.py`
var/artifacts/

# V2 — dữ liệu runtime tái lập được (crawl DB SQLite, catalog V2, tổng kết build)
# Catalog V2 = legacy CSV (từng có sẵn trong repo) + crawl DB theo `scripts/collect_data.py`
var/data/collect/
var/data/itlr_v2_items.csv
var/data/last_build.json

# linh tinh hệ điều hành / editor
.DS_Store
*.swp

# Giữ báo cáo nghiệm thu trong Git. CI tải JUnit XML lên dưới dạng artifact.
/reports/pytest.xml
/graphify-out/

# Local model runtimes/download caches
var/cache/
var/downloads/
var/ollama/
var/hf/

var/data/web_items.csv

# Local process coordination (never remove while jobs are running)
var/data/.pipeline.lock
var/data/.refresh.lock

# Python coverage data (local)
.coverage
.coverage.*
